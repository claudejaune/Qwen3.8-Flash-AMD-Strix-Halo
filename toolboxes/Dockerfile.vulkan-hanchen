# Builds the llama-vulkan-hanchen image.
# Derived from kyuz0/amd-strix-halo-toolboxes (gguf-vram-estimator removed).
# https://github.com/kyuz0/amd-strix-halo-toolboxes
# build stage
# danielhanchen/llama.cpp `qwen4exp/mtp` branch, built with the standard
# AMD / Vulkan (Mesa RADV) settings from Dockerfile.vulkan-radv.
#
# The upstream branch author recommends:
#   cmake -DBUILD_SHARED_LIBS=OFF -DGGML_CUDA=ON
#   --target llama-cli llama-mtmd-cli llama-server llama-gguf-split
# Here GGML_CUDA is replaced by GGML_VULKAN (plus GGML_RPC, as in vulkan-radv),
# and the target list is kept, with ggml-rpc-server and llama-bench added to
# match the radv toolbox tool set. Since only a target subset is built, the
# binaries are copied from build/bin/ instead of using `cmake --install`.
FROM registry.fedoraproject.org/fedora:43 AS builder

# deps
RUN dnf -y --nodocs --setopt=install_weak_deps=False install \
  git vim \
  make gcc cmake ninja-build lld clang clang-devel compiler-rt libcurl-devel rdma-core-devel \
  vulkan-loader-devel vulkaninfo mesa-vulkan-drivers \
  spirv-headers-devel radeontop glslc patch \
  && dnf clean all && rm -rf /var/cache/dnf/*

# llama.cpp (danielhanchen fork, qwen4exp/mtp)
WORKDIR /opt/llama.cpp
ARG REPO=https://github.com/danielhanchen/llama.cpp.git
ARG BRANCH=qwen4exp/mtp
RUN git clone -b ${BRANCH} --single-branch --recursive ${REPO} .

# build (vulkan-radv settings, author-specified targets)
RUN git clean -xdf \
  && git submodule update --recursive \
  && cmake -S . -B build -G Ninja \
  -DGGML_VULKAN=ON \
  -DBUILD_SHARED_LIBS=OFF \
  -DCMAKE_BUILD_TYPE=Release \
  -DGGML_RPC=ON \
  -DCMAKE_INSTALL_PREFIX=/usr \
  -DLLAMA_BUILD_TESTS=OFF \
  -DLLAMA_BUILD_EXAMPLES=ON \
  -DLLAMA_BUILD_SERVER=ON \
  && cmake --build build --config Release --clean-first -j28 \
     --target llama-cli llama-mtmd-cli llama-server llama-gguf-split llama-bench ggml-rpc-server \
  && mkdir -p /usr/local/bin \
  && cp -a build/bin/llama-* build/bin/ggml-rpc* /usr/local/bin/

# libs
RUN find /opt/llama.cpp/build -type f -name 'lib*.so*' -exec cp {} /usr/lib64/ \; \
  && ldconfig


# runtime stage
FROM registry.fedoraproject.org/fedora-minimal:43

# runtime deps
RUN microdnf -y --nodocs --setopt=install_weak_deps=0 install \
  bash ca-certificates libatomic libstdc++ libgcc libibverbs \
  vulkan-loader vulkan-loader-devel vulkaninfo mesa-vulkan-drivers radeontop procps-ng \
  && microdnf clean all && rm -rf /var/cache/dnf/*

# copy
COPY --from=builder /usr/ /usr/
COPY --from=builder /usr/local/ /usr/local/
COPY --from=builder /opt/llama.cpp/build/bin/ggml-rpc-* /usr/local/bin/

# ld
RUN echo "/usr/local/lib"  > /etc/ld.so.conf.d/local.conf \
  && echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local.conf \
  && ldconfig \
  && cp -n /usr/local/lib/libllama*.so* /usr/lib64/ 2>/dev/null || true \
  && ldconfig

# shell
CMD ["/bin/bash"]
