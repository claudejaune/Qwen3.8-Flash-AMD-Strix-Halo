# Builds the llama-vulkan-laurentz image: llama.cpp LaurentZuijdwijk fork
# (branch vulkan/qwen4exp-rocmfpx) with Vulkan support for ROCmFP4 quants.
# Derived from kyuz0/amd-strix-halo-toolboxes (gguf-vram-estimator removed).
# https://github.com/kyuz0/amd-strix-halo-toolboxes
# build stage
FROM registry.fedoraproject.org/fedora:43 AS builder

# deps
RUN dnf -y --nodocs --setopt=install_weak_deps=False install \
  git vim \
  make gcc cmake ninja-build lld clang clang-devel compiler-rt libcurl-devel rdma-core-devel \
  vulkan-loader-devel vulkaninfo mesa-vulkan-drivers \
  spirv-headers-devel radeontop glslc patch \
  && dnf clean all && rm -rf /var/cache/dnf/*

# llama.cpp (LaurentZuijdwijk fork)
WORKDIR /opt/llama.cpp
ARG REPO=https://github.com/LaurentZuijdwijk/llama.cpp.git
ARG BRANCH=vulkan/qwen4exp-rocmfpx
RUN git clone -b ${BRANCH} --single-branch --recursive ${REPO} .

# build
RUN git clean -xdf \
  && git submodule update --recursive \
  && cmake -S . -B build -G Ninja \
  -DGGML_VULKAN=ON \
  -DCMAKE_BUILD_TYPE=Release \
  -DGGML_RPC=ON \
  -DCMAKE_INSTALL_PREFIX=/usr \
  -DLLAMA_BUILD_TESTS=OFF \
  -DLLAMA_BUILD_EXAMPLES=ON \
  -DLLAMA_BUILD_SERVER=ON \
  && cmake --build build --config Release -j"$(nproc)" \
  && cmake --install build --config Release

# libs — staged in a dedicated dir so the runtime stage can copy exactly the
# llama.cpp libs, whatever they are named (libggml*, libllama*, libmtmd, ...),
# instead of globbing in /usr/lib64 where the build toolchain also lives.
RUN mkdir -p /opt/llama-libs \
  && find /opt/llama.cpp/build -type f -name 'lib*.so*' -exec cp {} /opt/llama-libs/ \;


# runtime stage
FROM registry.fedoraproject.org/fedora-minimal:43

# runtime deps — covers the full DT_NEEDED closure of the llama binaries
RUN microdnf -y --nodocs --setopt=install_weak_deps=0 install \
  bash ca-certificates libatomic libstdc++ libgcc libgomp libcurl \
  openssl-libs libibverbs libnl3 \
  vulkan-loader vulkaninfo mesa-vulkan-drivers radeontop procps-ng \
  && microdnf clean all && rm -rf /var/cache/dnf/*

# copy — targeted only: copying all of /usr from the builder would ship the
# entire build toolchain (git, gcc, clang, cmake, ...) in the runtime image.
COPY --from=builder /usr/bin/llama-* /usr/bin/
COPY --from=builder /usr/bin/ggml-* /usr/bin/
COPY --from=builder /opt/llama-libs/ /usr/lib64/

# ld
RUN ldconfig

# shell
CMD ["/bin/bash"]
